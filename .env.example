# ==============================================================================
# Meta Muse Registration & 1B Token Invite Redemption - Environment Config
# ==============================================================================

# Environment mode: development | production | test
MUSE_ENV=development

# Logging configuration: DEBUG | INFO | WARNING | ERROR
MUSE_LOG_LEVEL=INFO

# Base API Configuration
MUSE_API_BASE_URL=https://hatch-api.meta.ai
MUSE_API_TIMEOUT=30.0
MUSE_API_VERSION=1.0.0

# User / Registration Defaults
MUSE_DEFAULT_REGION=US
MUSE_AUTO_RESUME_SESSION=true

# Storage Paths
MUSE_SESSION_CACHE_FILE=./data/sessions/session_cache.json
MUSE_CREDENTIALS_FILE=./data/sessions/credentials.json
